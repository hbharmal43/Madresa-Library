# /etc/systemd/system/madresa-library.service
[Unit]
Description=Madresa Library (Django via Gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/srv/madresa-library
EnvironmentFile=/srv/madresa-library/.env
ExecStart=/srv/madresa-library/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/madresa-library.sock \
    --workers 3 \
    --timeout 60
Restart=always

[Install]
WantedBy=multi-user.target
