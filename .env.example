# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank for local SQLite. On EC2 point this at Postgres, e.g.
# DATABASE_URL=postgres://library:password@localhost:5432/library
DATABASE_URL=

# Comma-separated origins for CSRF when behind HTTPS on EC2, e.g.
# CSRF_TRUSTED_ORIGINS=https://library.example.org
CSRF_TRUSTED_ORIGINS=

# Default loan length in days (librarian can still pick another at checkout)
DEFAULT_LOAN_DAYS=14
TIME_ZONE=America/Chicago
